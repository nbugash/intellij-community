    name = "i_build_target",
    add_opens = INTELLIJ_ADD_OPENS,
    data = ALL_COMMUNITY_TARGETS + [BAZEL_TARGETS_JSON_COMMUNITY],
    jvm_flags = [
        "-Dintellij.build.bazel.targets.json.file=$(rlocationpath %s)" % BAZEL_TARGETS_JSON_COMMUNITY,
    ],
    main_class = "org.jetbrains.intellij.build.thinClient.ThinClientInstallersBuildTarget",
    runtime_deps = [":thin-client"],
)

# SC-013 and SC-014. Verifies what a build produced: every licence is approved, and no produced file
# holds a credential. Hand-written, outside every auto-generated section.
java_binary(
    name = "verify-artifacts",
    main_class = "org.jetbrains.intellij.build.thinClient.VerifyArtifacts",
    runtime_deps = [":thin-client"],
)

# Constitution Principle 2, Clean Code. Task T123. Reports outliers by name and fails on any.
# Hand-written, outside every auto-generated section.
java_binary(
    name = "clean-code-gate",
    main_class = "org.jetbrains.intellij.build.thinClient.CleanCodeGateMain",
    runtime_deps = [":thin-client"],
)

