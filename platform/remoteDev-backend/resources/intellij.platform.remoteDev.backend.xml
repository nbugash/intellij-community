<idea-plugin visibility="public">
  <!-- Hand-written. Upstream this region is generated by 'Generate Product Layouts', which could not
       be run here. See META-INF/RemoteBackendPlugin.xml for the full reason. Keep in step with
       intellij.platform.remoteDev.backend.iml. -->
  <dependencies>
    <module name="intellij.libraries.jetbrains.annotations"/>
    <module name="intellij.libraries.kotlinx.coroutines.core"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.ide"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.core.impl"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.projectModel.impl"/>
    <module name="intellij.platform.remoteDev.protocol"/>
    <module name="intellij.platform.rpc"/>
    <module name="intellij.platform.rpc.backend"/>
    <module name="intellij.platform.serviceContainer"/>
    <module name="intellij.platform.util"/>
  </dependencies>

  <extensions defaultExtensionNs="com.intellij">
    <appStarter id="splitBackend" implementation="com.intellij.remoteDev.backend.SplitBackendStarter" internal="true"/>
    <platform.rpc.backend.remoteApiProvider implementation="com.intellij.remoteDev.backend.BackendSessionApiProvider"/>
  </extensions>
</idea-plugin>
