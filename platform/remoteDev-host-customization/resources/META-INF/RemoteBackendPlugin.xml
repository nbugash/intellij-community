<!--
  HAND-WRITTEN, and that is a deviation worth knowing about. The same one ThinClientPlugin.xml
  carries, for the same reason: the generator's Bazel target //platform/buildScripts:plugin-model-tool
  does not exist in this checkout, the directory being platform/build-scripts with a hyphen.

  This states by hand what the generator would emit from
  org.jetbrains.intellij.build.remoteBackend.BackendProperties.getProductContentDescriptor().

  RISK: this file and that function can drift apart. Whoever finds the working generator invocation
  should regenerate this file and delete this comment.
-->
<idea-plugin xmlns:xi="http://www.w3.org/2001/XInclude">
  <!-- The core plugin of a product must be "com.intellij". The loader looks it up by that id
       and refuses to start without it: "Missing essential plugin: com.intellij". The id names the
       role, not the vendor, so FR-002 is not at stake. -->
  <id>com.intellij</id>
  <name>Remote Development Backend CORE</name>

  <module value="com.intellij.modules.platform"/>
  <module value="com.intellij.modules.lang"/>

  <xi:include href="/META-INF/intellij.moduleSets.essential.xml"/>

  <content namespace="jetbrains">
    <!-- loading="embedded" is what puts this module's jar on the main class loader.
         deprecatedLoadCorePluginForModuleBasedLoader looks the core descriptor up as
         META-INF/${platformPrefix}Plugin.xml on that class loader and returns null when it is not
         there, and a null core plugin surfaces as "Missing essential plugin: com.intellij".
         addMainModuleGroupToClassPath only adds modules whose loading rule is EMBEDDED.
         IdeaPlugin.xml marks its own customization module the same way. -->
    <module name="intellij.platform.remoteDev.backend" loading="embedded"/>
    <module name="intellij.platform.remoteDev.host.customization" loading="embedded"/>
  </content>
</idea-plugin>
